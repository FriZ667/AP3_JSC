<Page x:Class="AP3_Journee_Sante.PageEdition"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageEdition">

    <Grid Background="White">
        <Label Content="Créer une nouvelle édition" HorizontalAlignment="Center" Margin="0,42,0,0" VerticalAlignment="Top" FontSize="24" FontFamily="Arial Black"/>
        <Button x:Name="btncreerjournee" Content="CREER" HorizontalAlignment="Center" Margin="0,300,0,0" VerticalAlignment="Top" Height="48" Width="150" BorderThickness="1,1,1,1" FontSize="18" Background="#FF82F94F" Foreground="White" BorderBrush="White" Click="btncreerjournee_Click"/>
        <Label Content="Ajouter un lieu :" HorizontalAlignment="Left" Margin="257,0,0,0" VerticalAlignment="Center" FontSize="18"/>
        <Label Content="Choisir une date :" HorizontalAlignment="Left" Margin="245,142,0,0" VerticalAlignment="Top" FontSize="18"/>

        <!-- ✅ DatePicker bien positionné -->
        <DatePicker x:Name="dpDateJournee"
                    HorizontalAlignment="Left"
                    Margin="458,150,0,0"
                    VerticalAlignment="Top"
                    Width="144"/>

        <TextBox x:Name="tblieujournee" HorizontalAlignment="Left" Margin="458,220,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="144"/>

    </Grid>
</Page>
