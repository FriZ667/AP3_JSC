<Page x:Class="AP3_Journee_Sante.PageLier"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageLier">

    <Grid Background="White">
        <Label Content="Lier une association à une journée" HorizontalAlignment="Center" Margin="0,42,0,0" VerticalAlignment="Top" FontSize="24" FontFamily="Arial Black"/>
        <ComboBox x:Name="cbjournee" DisplayMemberPath="Date" HorizontalAlignment="Left" Margin="422,199,0,0" VerticalAlignment="Top" Width="144" SelectionChanged="cbjournee_SelectionChanged"/>
        <Label Content="Choisir la journée :" HorizontalAlignment="Left" Margin="241,191,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Button x:Name="btnlier" Content="LIER" HorizontalAlignment="Center" Margin="0,300,0,0" VerticalAlignment="Top" Height="48" Width="150" BorderThickness="1,1,1,1" FontSize="18" Background="#FF82F94F" Foreground="White" BorderBrush="White" Click="btnlier_Click"/>
        <Label Content="Association :" HorizontalAlignment="Left" Margin="210,102,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label x:Name="lblasso" Content="Nom Asso" HorizontalAlignment="Center" Margin="0,102,0,0" VerticalAlignment="Top" FontSize="18"/>

    </Grid>
</Page>
