<Page x:Class="AP3_Journee_Sante.PageCreeAsso"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageCreeAsso">

    <Grid Background="White">

        <!-- Titre en haut -->
        <Label Content="Ajouter une nouvelle association"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,30,0,0"
               FontSize="24"
               FontFamily="Arial Black"/>

        <!-- Bloc formulaire centré -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,20,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nom -->
            <Label Grid.Row="0" Grid.Column="0"
                   Content="Nom de l'association :" FontSize="18"/>
            <TextBox x:Name="tbcreenomasso"
                     Grid.Row="0" Grid.Column="2"
                     Width="180"
                     TextChanged="tbcreenomasso_TextChanged"/>
            <Label x:Name="lblcreenomimage_Copy1"
                   Grid.Row="0" Grid.Column="4"
                   Content="OBLIGATOIRE"
                   FontSize="14"
                   FontFamily="Berlin Sans FB Demi"/>

            <!-- Mail -->
            <Label Grid.Row="1" Grid.Column="0"
                   Content="Mail de l'association :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="btncreemailasso"
                     Grid.Row="1" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- Téléphone -->
            <Label Grid.Row="2" Grid.Column="0"
                   Content="Téléphone de l'association :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="btncreetelasso"
                     Grid.Row="2" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- Image + nom image -->
            <Button x:Name="btncreeimage"
                    Grid.Row="3" Grid.Column="0"
                    Content="Choisir image"
                    Width="120" Height="30"
                    Margin="0,15,0,0"
                    Click="btncreeimage_Click"/>

            <Label x:Name="lblcreenomimage"
                   Grid.Row="3" Grid.Column="2"
                   Content="Nom image"
                   Margin="0,15,0,0"/>

            <Image x:Name="imgNouvelleAsso"
                   Grid.Row="3" Grid.Column="4"
                   Width="80" Height="80"
                   Margin="10,5,0,0"
                   Stretch="Uniform"/>

            <!-- Boutons bas -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">

                <Button x:Name="btnretourasso"
                        Content="Retour"
                        Width="150" Height="40"
                        FontSize="18"
                        Background="Gray"
                        Foreground="White"
                        BorderBrush="White"
                        Click="btnretourasso_Click"
                        Margin="0,0,20,0"/>

                <Button x:Name="btncreerasso"
                        Content="CREER"
                        Width="150" Height="40"
                        FontSize="18"
                        Background="#FF82F94F"
                        Foreground="White"
                        BorderBrush="White"
                        Click="btncreerasso_Click"/>

                <Label x:Name="ConfirmCreeAsso"
                       Content="L'association a été ajoutée"
                       FontSize="16"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
