<Page x:Class="AP3_Journee_Sante.PageCreerMembre"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageCreerMembre"
      Loaded="Page_Loaded">

    <Grid Background="White">

        <!-- TITRE -->
        <Label Content="Ajouter des membres à une association"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,30,0,0"
               FontSize="24"
               FontFamily="Arial Black"/>

        <!-- FORMULAIRE CENTRÉ -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,20,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Association -->
            <Label Grid.Row="0" Grid.Column="0"
                   Content="Association :" FontSize="18"/>
            <ComboBox x:Name="cbasso"
                      Grid.Row="0" Grid.Column="2"
                      Width="180"
                      DisplayMemberPath="NomAsso"
                      SelectedValuePath="IdAsso"
                      SelectionChanged="cbasso_SelectionChanged"/>

            <!-- Nom -->
            <Label Grid.Row="1" Grid.Column="0"
                   Content="Nom du membre :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="btncreemembrenom"
                     Grid.Row="1" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- Prénom -->
            <Label Grid.Row="2" Grid.Column="0"
                   Content="Prénom du membre :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="btncreemembreprenom"
                     Grid.Row="2" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- Fonction -->
            <Label Grid.Row="3" Grid.Column="0"
                   Content="Fonction du membre :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="btncreefonctionmembre"
                     Grid.Row="3" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- Boutons -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">

                <Button x:Name="btnretourmembre"
                        Content="Retour"
                        Width="150" Height="40"
                        FontSize="18"
                        Background="Gray"
                        Foreground="White"
                        BorderBrush="White"
                        Click="btnretourmembre_Click"
                        Margin="0,0,20,0"/>

                <Button x:Name="btncreermembre"
                        Content="CREER"
                        Width="150" Height="40"
                        FontSize="18"
                        Background="#FF82F94F"
                        Foreground="White"
                        BorderBrush="White"
                        Click="btncreermembre_Click"/>

                <Label x:Name="ConfirmCreeMembre"
                       Content="Le membre a été ajouté"
                       FontSize="16"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
