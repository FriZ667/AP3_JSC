<Page x:Class="AP3_Journee_Sante.PageAjouterRep"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAjouterRep">

    <Grid Background="White">
        <Label Content="Ajouter une réponse" HorizontalAlignment="Center" Margin="0,42,0,0" VerticalAlignment="Top" FontSize="24" FontFamily="Arial Black"/>
        <ComboBox x:Name="cbinvite" DisplayMemberPath="Date" HorizontalAlignment="Left" Margin="414,113,0,0" VerticalAlignment="Top" Width="144"/>
        <Label Content="Choisir Association :" HorizontalAlignment="Left" Margin="227,105,0,0" VerticalAlignment="Top" FontSize="18"/>
        <ComboBox x:Name="cbinvite_Copy" DisplayMemberPath="Date" HorizontalAlignment="Left" Margin="414,157,0,0" VerticalAlignment="Top" Width="144"/>
        <Label Content="Choisir Journée :" HorizontalAlignment="Left" Margin="227,149,0,0" VerticalAlignment="Top" FontSize="18"/>
        <ComboBox x:Name="cbinvite_Copy1" DisplayMemberPath="Date" HorizontalAlignment="Left" Margin="297,202,0,0" VerticalAlignment="Top" Width="388"/>
        <Label Content="Choisir Question :" HorizontalAlignment="Left" Margin="118,194,0,0" VerticalAlignment="Top" FontSize="18"/>
        <TextBox x:Name="tbModifCom" HorizontalAlignment="Left" Margin="118,261,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="435" Height="77"/>
        <Button x:Name="btnaddrep" Content="Valider" HorizontalAlignment="Left" Margin="575,273,0,0" VerticalAlignment="Top" Height="53" Width="132" BorderThickness="1,1,1,1" Background="#FF82F94F" Foreground="White" BorderBrush="White"/>

    </Grid>
</Page>
