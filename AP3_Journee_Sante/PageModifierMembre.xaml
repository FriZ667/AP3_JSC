<Page x:Class="AP3_Journee_Sante.PageModifierMembre"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP3_Journee_Sante"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Modifier un membre">

    <Grid Background="White">

        <!-- TITRE -->
        <Label Content="Modifier un membre"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,10,0,0"
               FontSize="24"
               FontFamily="Arial Black"/>

        <!-- FORMULAIRE CENTRÉ -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,92,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>


            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- NOM -->
            <Label Grid.Row="0" Grid.Column="0"
                   Content="Nom du membre de l'association :" FontSize="18"/>
            <TextBox x:Name="tbmodifNom"
                     Grid.Row="0" Grid.Column="2"
                     Width="180"/>

            <!-- MAIL -->
            <Label Grid.Row="1" Grid.Column="0"
                   Content="Prénom du membre de l'association  :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="tbmodifPrenom"
                     Grid.Row="1" Grid.Column="2"
                     Width="180" Margin="0,10,0,0"/>

            <!-- TEL -->
            <Label Grid.Row="2" Grid.Column="0"
                   Content="Fonction du membre dans l'association :" FontSize="18" Margin="0,10,0,0"/>
            <TextBox x:Name="tbmodifFunction"
                     Grid.Row="2" Grid.Column="2"
                     Width="180" Margin="10,10,10,105"/>



            <!-- ASSOCIATION (COMBOBOX) -->
            <Label Grid.Row="2" Grid.Column="0"
                   Content="L'association du membre:" FontSize="18" Margin="10,61,10,58" Grid.ColumnSpan="2"/>
            <ComboBox x:Name="cbAsso"
                      Grid.Row="2" Grid.Column="2"
                      Width="180" Margin="10,70,10,61"/>



            <!-- BOUTON RETOUR -->
            <Button x:Name="btnretour"
                    Grid.Row="2"
                    Content="Retour"
                    Width="102"
                    FontSize="18"
                    Background="Gray"
                    Foreground="White"
                    BorderBrush="White"
                    Margin="32,149,0,-24"
                    HorizontalAlignment="Left"
                    Click="btnretour_Click" Grid.Column="2" Grid.RowSpan="2"/>

            <!-- BOUTON MODIFIER -->
            <Button x:Name="btnmodifmembre"
                    Grid.Row="2"
                    Content="Modifier"
                    Width="102"
                    FontSize="18"
                    Background="#FF82F94F"
                    Foreground="White"
                    BorderBrush="White"
                    Margin="0,149,0,-24"
                    HorizontalAlignment="Center"
                    Click="btnmodifmembre_Click" Grid.RowSpan="2"/>

        </Grid>

    </Grid>
</Page>
